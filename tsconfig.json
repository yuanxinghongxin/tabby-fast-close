{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true,
    "importHelpers": false,
    "sourceMap": false,
    "strict": false
  },
  "include": ["src/**/*.ts"]
}
