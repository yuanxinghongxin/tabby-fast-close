{
  "name": "tabby-fast-close",
  "version": "1.0.0",
  "description": "Make Cmd+W close local terminal tabs instantly via EOF (Ctrl-D) instead of Tabby's slow close path - without writing any command into shell history.",
  "author": {
    "name": "yuanxinghong"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuanxinghongxin/tabby-fast-close.git"
  },
  "homepage": "https://github.com/yuanxinghongxin/tabby-fast-close#readme",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch"
  },
  "devDependencies": {
    "@angular/core": "^15.2.6",
    "@types/node": "^18.19.0",
    "rxjs": "^7.5.7",
    "tabby-core": "1.0.231-nightly.0",
    "ts-loader": "^9.6.2",
    "tslib": "^2.5.0",
    "typescript": "~4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.0.1"
  },
  "peerDependencies": {
    "@angular/core": "^15",
    "rxjs": "^7",
    "tabby-core": "*"
  }
}
